# Copy this file to backend/.env and fill in your values.
# Never commit backend/.env — it's in .gitignore for a reason.

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_32_BYTES_MIN

# ── Database ──────────────────────────────────────────────────────────────────
# Defaults to SQLite for local development (no setup needed)
DATABASE_URL=sqlite+aiosqlite:///./grid07.db
# For PostgreSQL: DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/grid07

# ── LLM Providers ────────────────────────────────────────────────────────────
# Groq — free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# xAI Grok — https://console.x.ai/
XAI_API_KEY=your_xai_api_key_here

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter (access to many models) — https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Custom OpenAI-compatible endpoint (e.g., Ollama, LM Studio)
OPENAI_COMPATIBLE_API_KEY=your_api_key_here
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1

# ── LLM Routing ──────────────────────────────────────────────────────────────
DEFAULT_LLM_PROVIDER=groq
DEFAULT_LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=45.0
LLM_MAX_TOKENS=768

# ── Search ────────────────────────────────────────────────────────────────────
# Exa (Primary search provider) — https://exa.ai
EXA_API_KEY=your_exa_api_key_here

# Tavily (Secondary search fallback) — https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

SEARCH_PROVIDER=exa
SEARCH_FALLBACK_PROVIDER=tavily
SEARCH_MAX_RESULTS=5
SEARCH_CACHE_TTL_SECONDS=3600
SEARCH_TIMEOUT_SECONDS=10.0
# Set to true to use mock results without network access (for development/tests)
ENABLE_DEVELOPMENT_MOCK_SEARCH=false

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000
